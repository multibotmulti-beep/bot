generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String?
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  phoneNumber String       @unique
  bots        BotProfile[]

  @@map("users")
}

model ApiCredential {
  id          String       @id @default(uuid())
  apiName     String       @unique
  apiKey      String
  apiSecret   String
  targetUrl   String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  webhookLogs WebhookLog[]

  @@map("api_credentials")
}

model WebhookLog {
  id           String        @id @default(uuid())
  credentialId String
  event        String
  payload      String
  responseCode Int?
  responseBody String?
  status       String
  createdAt    DateTime      @default(now())
  credential   ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model BotProfile {
  id          String    @id @default(uuid())
  botId       String    @unique
  name        String
  description String?
  type        String    @default("custom")
  isPublic    Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  phoneNumber String    @default("")
  userId      String?
  flows       BotFlow[]
  user        User?     @relation(fields: [userId], references: [id])
  rules       BotRule[]

  @@map("bot_profiles")
}

model BotRule {
  id              String      @id @default(uuid())
  botProfileId    String?
  keyword         String
  matchType       String      @default("exact")
  responseMessage String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  botProfile      BotProfile? @relation(fields: [botProfileId], references: [id], onDelete: Cascade)

  @@map("bot_rules")
}

model BotFlow {
  id              String      @id @default(uuid())
  botProfileId    String?
  parentId        String?
  name            String
  triggerKeyword  String
  flowType        String
  content         String
  responseMessage String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  botProfile      BotProfile? @relation(fields: [botProfileId], references: [id], onDelete: Cascade)
  parent          BotFlow?    @relation("FlowHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        BotFlow[]   @relation("FlowHierarchy")

  @@map("bot_flows")
}

model BotSession {
  senderPhone         String   @id
  activeBotId         String   @default("admin")
  wizardStep          Int      @default(0)
  draftName           String?
  draftStyle          String?
  draftOptions        String?
  draftPath           String?
  currentParentFlowId String?
  updatedAt           DateTime @updatedAt

  @@map("bot_sessions")
}
