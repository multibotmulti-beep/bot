{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "build": "tsup src/index.ts --format cjs --dts --external @prisma/client",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/logger": "workspace:*",
    "eslint": "^9.11.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
